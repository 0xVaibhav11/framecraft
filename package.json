{
  "name": "framepay-sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "FramePay SDK prototype and frame-devnet development tooling",
  "workspaces": [
    "apps/*",
    "packages/*",
    "contracts"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "bun": ">=1.3.6"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "bun run web:dev",
    "build": "lerna run build && bun run examples:typecheck",
    "build:verify": "lerna run build --skip-nx-cache && bun run examples:typecheck",
    "check:commit": "git diff --cached --check",
    "check:push": "bun run build:verify",
    "contracts:build": "bun run --cwd contracts build",
    "contracts:test": "bun run --cwd contracts test",
    "contracts:fmt": "bun run --cwd contracts fmt",
    "paymaster:build": "node scripts/paymaster/build.mjs",
    "paymaster:test": "bun run contracts:test",
    "paymaster:deploy": "bun run sdk:build && node scripts/paymaster/deploy.mjs",
    "transaction:inspect": "bun run sdk:build && node scripts/paymaster/inspect.mjs",
    "devnet:inspect": "node scripts/devnet/inspect.mjs",
    "devnet:smoke": "bun run sdk:build && node scripts/devnet/smoke.mjs",
    "sdk:bootstrap": "node scripts/link-workshop-deps.mjs",
    "web:bootstrap": "node scripts/link-web-deps.mjs",
    "web:dev": "bun run sdk:build && bun run --cwd apps/web dev",
    "web:build": "lerna run build --scope @framepay/docs --include-dependencies",
    "web:typecheck": "bun run sdk:build && bun run --cwd apps/web typecheck",
    "sdk:build": "bun run --cwd packages/sdk build",
    "examples:typecheck": "tsc -p examples/tsconfig.json",
    "test": "bun run sdk:build && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@forshtat/hegota-support": "0.0.1",
    "@framepay/sdk": "workspace:*",
    "effect": "^4.1.2",
    "husky": "9.1.7",
    "lerna": "9.0.7",
    "typescript": "7.0.2",
    "viem": "2.57.11"
  },
  "packageManager": "bun@1.3.6"
}
