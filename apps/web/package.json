{
  "name": "@framepay/web",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "evmcrispr": {
    "repo": "https://github.com/EVMcrispr/evmcrispr.git",
    "branch": "next",
    "commit": "59807edbb477ad17d33b7b5a2ccd7fb875c5566f"
  },
  "scripts": {
    "prepare:evmcrispr": "node scripts/vendor-evmcrispr.mjs && node scripts/copy-monaco.mjs",
    "dev": "bun run prepare:evmcrispr && bun run prepare:privacy && astro dev",
    "build": "bun run prepare:evmcrispr && bun run prepare:privacy && astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "bun run prepare:evmcrispr && astro check",
    "prepare:privacy": "bun run --cwd ../../packages/sdk build && bun run --cwd ../../packages/privacy build && node scripts/prepare-privacy.mjs",
    "test:privacy": "node scripts/test-privacy.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.4",
    "@framepay/sdk": "workspace:*",
    "astro": "^7.4.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "2.57.11"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@emnapi/runtime": "1.11.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^6",
    "vercel": "^65.12.1"
  }
}
